doctype html 
html    
    head 
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1")
        title #{ title || "Course" }
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="https://unpkg.com/tailwindcss@^2/dist/tailwind.min.css")
    body
        .max-w-5xl.mx-auto.py-16.px-5
            div.text-right
                a(href="/update-cobj" class="px-8 py-3 border-2 border-pink-700 inline-block text-white text-sm font-bold bg-pink-700 transition-all cursor-pointer hover:bg-white hover:text-pink-700") Add New Course
                div(class="relative overflow-x-auto mt-6")
                    table(class="w-full text-left border-separate rounded-xl")
                        thead(class="border-b")
                            tr.bg-gray-50.text-gray-800
                                th(scope="col", class="border border-gray-200 px-6 py-3 font-bold") Name of the Course
                                th(scope="col", class="border border-gray-200 px-6 py-3 font-bold") Course Owner
                                th(scope="col", class="border border-gray-200 px-6 py-3 font-bold") Course ID
                                th(scope="col", class="border border-gray-200 px-6 py-3 font-bold") Price
                        tbody
                            each row in rows
                                tr.text-gray-600
                                    td(class="font-semibold px-6 py-3 border border-gray-200")= row.name_of_the_course || '_'
                                    td(class="px-6 py-3 border border-gray-200")= row.course_owner || '_'
                                    td(class="px-6 py-3 border border-gray-200")= row.course_id || '_'
                                    td(class="font-semibold text-gray-800 px-6 py-3 border border-gray-200")= row.price || '_'